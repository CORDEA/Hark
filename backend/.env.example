# Copy to backend/.env and fill in your deployment values.
# `docker compose up` auto-loads this file; `go run ./cmd/hark` does not
# (either export them in your shell or use a tool like `direnv` / `mise`).

# Required. Base URL clients hit — becomes the WebAuthn origin and RP ID
# host. The process refuses to boot without it. Every registered passkey
# is bound to this hostname; changing it later invalidates every credential.
PUBLIC_URL=http://localhost:8080

# Displayed in the subscriber dashboard.
ORG_NAME=Hark

# iOS: comma-separated <TeamID>.<BundleID> list served in AASA.
# Get TeamID from developer.apple.com → Membership.
APPLE_APP_IDS=

# Android: comma-separated <package>:<sha256-fingerprint> list served in
# assetlinks.json. Get fingerprint via
#   keytool -list -v -keystore <keystore> -alias <alias>
ANDROID_APP_LINKS=

# Only flip to `true` for an intentional domain move — invalidates every
# registered passkey. Leave `false` in normal operation.
RP_ID_OVERRIDE=false
