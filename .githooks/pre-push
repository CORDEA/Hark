#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if command -v mise >/dev/null 2>&1; then
  exec mise exec gitleaks -- gitleaks detect --no-banner --redact
fi

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks detect --no-banner --redact
fi

echo "gitleaks is required before pushing; run 'mise install'." >&2
exit 1
